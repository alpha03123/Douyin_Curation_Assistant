# Backend port
PORT=3001

# Bind the Web panel and MCP endpoint locally by default.
HOST=127.0.0.1

# Optional: root directory used for local persisted data
DATA_ROOT=./jsonData

# Optional: SQLite database file path
SQLITE_PATH=./jsonData/douyin_curation_assistant.db

# Frontend origins allowed by the backend
# Single origin is still supported via CLIENT_ORIGIN, but CLIENT_ORIGINS is
# recommended for future online deployments with multiple domains.
CLIENT_ORIGIN=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# Frontend dev proxy target used by Vite during local development
VITE_DEV_PROXY_TARGET=http://localhost:3001

# Optional legacy project root path
LEGACY_PROJECT_PATH=../

# Douyin web Cookie string copied from your logged-in browser
DY_COOKIES=

# Required Bearer token for the Streamable HTTP MCP endpoint at /mcp.
MCP_AUTH_TOKEN=

# Browser automation execution mode
# false: show a visible browser window for easier debugging
# true: run action execution in the background
ACTION_BROWSER_HEADLESS=false

# Keep the browser window open for a while after a failure
ACTION_BROWSER_KEEP_OPEN_ON_FAILURE=true

# How long to keep the failed page open, in milliseconds
ACTION_BROWSER_FAILURE_HOLD_MS=45000

# Browser action execution timeout in milliseconds
ACTION_BROWSER_TIMEOUT_MS=60000

# Optional: default target work page used by `npm run capture:actions`
ACTION_CAPTURE_TARGET_URL=https://www.douyin.com/video/7604471631310035697
